# Copy this file to ".env" (same folder as pom.xml) and fill in your own values.
# The real .env file is ignored by git.

DB_URL=jdbc:mysql://localhost:3306/student_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_secret_value
JWT_EXPIRATION_MS=3600000

CORS_ORIGINS=http://localhost:5173

# Admin account created on first run (change the password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Insert ~24 demo students on first run when the table is empty
SEED_DEMO_DATA=true
